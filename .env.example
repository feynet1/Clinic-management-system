# Supabase Cloud Configuration
# Replace these with your Supabase Project Settings > API values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage / Cloudflare R2 Bucket
VITE_STORAGE_BUCKET=clinic-documents

# App Mode ('live' requires Supabase credentials, 'offline_demo' runs zero-config locally via IndexedDB)
VITE_APP_MODE=auto
